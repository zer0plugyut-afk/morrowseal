# Copy to your own env file (never commit it). Values below are placeholders.
NEAR_OPS_ID=your-ops-account.testnet
NEAR_OPS_KEY=ed25519:...
NEAR_CONTRACT_ID=your-vault-contract.testnet
NEAR_CONTRACT_KEY=ed25519:...
NEAR_OWNER_ID=demo-owner.testnet          # scripts/e2e.mjs only
NEAR_OWNER_KEY=ed25519:...
KEEPER_SK=hex                             # opens heir notices sealed by the enclave (its public half is compiled into the enclave)
PINATA_JWT=...
PINATA_GATEWAY=your-gateway.mypinata.cloud
BREVO_API_KEY=...
EMAIL_FROM=sender@example.com
EMAIL_FROM_NAME=Vault Keeper
APP_URL=https://your-app.example         # base for heir claim links
SERVE_WEB=1
KEEPER_INTERVAL_MS=20000
